{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sds-ebpf.dev/schema/events/canonical_event_v1.schema.json",
  "title": "SDS Canonical Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "observed_at",
    "host",
    "process",
    "workload",
    "sensor",
    "event"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "sds.event.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hostname"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "ppid",
        "comm",
        "binary",
        "uid"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "ppid": {
          "type": "integer",
          "minimum": 0
        },
        "comm": {
          "type": "string",
          "minLength": 1
        },
        "binary": {
          "type": "string",
          "minLength": 1
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service"
      ],
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "cgroup_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sampling_mode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sampling_mode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "category",
        "data"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        }
      }
    }
  }
}
